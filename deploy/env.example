# /etc/moodle-watch/env — mode 640, groupe du service. Jamais dans le depot.
# Aucun jeton Moodle ici : il reste dans le config.json du miroir.

MOODLE_WATCH_MIRROR=/home/you/Moodle
MOODLE_WATCH_DB=/home/you/Moodle/moodle_watch.db
MOODLE_WATCH_POLICY=/home/you/.config/moodle-watch/policy.toml
MOODLE_WATCH_PORT=3041

# Obligatoire derriere un proxy : le SDK valide l'en-tete Host contre cette
# liste. Le nom public doit y figurer, sinon le proxy recoit un 421.
MOODLE_WATCH_HOSTS=moodle.example.org

# Seulement pour `moodle-watch doctor --remote`.
#MOODLE_WATCH_BASE_URL=https://moodle.example.org
#MOODLE_WATCH_SEGMENT=le-segment-secret

# Pour la notification d'echec du timer.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
